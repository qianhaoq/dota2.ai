# ---------------------------------------------------------------------------
# dota2.ai environment example — copy to `.env` and fill in your own values.
# `.env` is gitignored. NEVER commit real keys. If a key ever lands in a commit,
# rotate it at the provider immediately.
# ---------------------------------------------------------------------------

# DeepSeek API key (REQUIRED for coach/review/chat features).
# Get your key: https://platform.deepseek.com/
# The server talks to DeepSeek's OpenAI-compatible endpoint.
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# DeepSeek model name (OPTIONAL, default: deepseek-flash).
# Must match /^[a-z0-9][a-z0-9._-]{0,63}$/i or the default is used.
# Recommended names per the official docs (checked 2026-10-17):
# deepseek-flash (DeepSeek-V4.1-Flash-1017) and deepseek-v4-pro. The retired
# legacy names deepseek-chat / deepseek-reasoner (retired 2026-07-24 per the
# DeepSeek V4 notice) are mapped to deepseek-flash with a startup warning.
# Docs: https://api-docs.deepseek.com/
# DEEPSEEK_MODEL=deepseek-flash

# DeepSeek thinking mode (OPTIONAL, default: disabled).
# deepseek-flash enables thinking (effort high) by default, which adds a lot
# of latency; review cards and follow-ups must answer within a 40s deadline,
# so the server disables it unless explicitly enabled. Accepted: enabled | disabled.
# DEEPSEEK_THINKING=disabled

# Gemini API key (OPTIONAL, recommended in production).
# Fallback provider for match-review cards when DeepSeek fails or times out
# (40s per attempt). Cards can also run on Gemini alone; follow-up chat still
# needs DeepSeek. GEMINI_REVIEW_MODEL overrides the default model.
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_REVIEW_MODEL=gemini-3.5-flash-lite

# Steam Web API key (OPTIONAL).
# Improves localized hero names via the Steam GetHeroes endpoint.
# Without it the server gracefully falls back to OpenDota constants.
# Get your key: https://steamcommunity.com/dev/apikey
# Also the fallback for "your recent games" when OpenDota is unavailable (a bare list:
# no result, K/D/A or duration). Free key: https://steamcommunity.com/dev/apikey
STEAM_WEB_API_KEY=

# OpenDota API key (OPTIONAL, recommended in production).
# Sent on EVERY OpenDota request (match data, explorer, constants, stats,
# recent matches, parse requests) through lib/upstream/opendota.js; never
# logged. Without it the server uses the anonymous tier (60/min, daily cap).
# Get your key: log in with Steam at https://www.opendota.com/api-keys
OPENDOTA_API_KEY=

# Durable match cache (OPTIONAL, recommended in production).
# A GCS bucket the service account can read and write. Parsed matches (which
# never change) and pro-case candidate lists are kept there, shared by every
# instance and deploy, so a match is fetched from OpenDota once. Unset: memory
# cache only. Setup commands: docs/MATCH_CACHE.md
MATCH_CACHE_BUCKET=

# STRATZ API token (OPTIONAL): fallback match source when OpenDota fails or
# is rate-limited. Its copies are basic and unparsed (lib/upstream/stratz.js).
# Get one at https://stratz.com/api. Check the mapping on a real match:
#   STRATZ_API_TOKEN=... node scripts/stratz-check.mjs 9091400302
STRATZ_API_TOKEN=

# OpenDota requests per minute for THIS instance (OPTIONAL).
# Defaults: 1200 with a key, 50 without. Page requests a user is waiting on go
# before background work (pro cases). Usage: GET /api/health/upstream
OPENDOTA_RPM=

# Trusted reverse-proxy hops (OPTIONAL).
# An EXACT topology count — the number of trusted proxies that append an entry
# to X-Forwarded-For before a request reaches this server. The client IP is
# taken as XFF[len-hops] for the per-client feedback rate limit and
# replay-parse budget. Do not tune it: measure the fronting topology instead.
#   1 (default) = Cloud Run direct or domain-mapped traffic: the Google Front
#                 End terminates TLS and appends exactly ONE entry — the real
#                 client (verified for dota2.ai: A records point at Google
#                 Front End 216.239.32/34/36/38.21, www is a
#                 ghs.googlehosted.com CNAME; no external HTTPS load balancer).
#   2           = an external HTTPS load balancer in front of Cloud Run (the
#                 LB appends "<client-ip>,<lb-ip>", client is 2nd from right)
#   +1 per extra fronting proxy (IAP / API Gateway / CDN)
# OVER-counting is dangerous: the pick drifts into the caller-controlled left
# side of the chain, letting clients spoof their IP and dodge per-client
# budgets. Under-counting is merely degrading (users share one bucket).
# Invalid or out-of-range values fall back to 1; the value is capped at 5.
# A chain shorter than the configured hops falls back to the (shared) proxy
# address — never an attacker-controlled left-side entry. X-Forwarded-For is
# only trusted when the TCP peer is private/loopback; direct public
# connections always use the socket address (spoof-safe).
TRUSTED_PROXY_HOPS=1

# Replay parse submission budgets (OPTIONAL, 10-minute sliding window).
# Global cap across all clients and per-client (IP) cap for submitting
# OpenDota parse requests. Over-budget requests are not submitted; the API
# returns parse status "throttled" with a retry hint instead.
PARSE_BUDGET_GLOBAL_MAX=10
PARSE_BUDGET_PER_CLIENT_MAX=3

# LLM endpoint per-IP rate limits + global cost guard (OPTIONAL, sliding window).
# Applies to /api/chat, /api/analyze, /api/playbook, POST /api/suggestions and
# POST /api/review/:matchId (GET /api/review/:matchId facts stays unlimited).
# Budget is consumed only by validated, LLM-bound requests (invalid 400s, cache
# hits and deterministic fallbacks never count), and IPv6 clients are keyed by
# their /64 prefix — one bucket per block, so rotating addresses inside a /64
# cannot multiply a budget. Over-limit clients get a 429 with a Retry-After
# header. LLM_GLOBAL_GUARD_<GROUP> is a generous global ceiling per group:
# when tripped, the request skips the LLM call and never gets a 429: review
# serves deterministic fallback cards/template, playbook a data-only answer,
# chat/analyze the generic 502 ai_unavailable (same as a provider outage).
# Suggestions never calls an LLM and has no global guard. One aggregated
# warning log every 60s.
# In-memory (per instance, resets on redeploy). Values are clamped to sane
# ceilings (window <= 1h, per-IP <= 1000, guard <= 100000).
LLM_RATE_WINDOW_MS=60000
LLM_RATE_CHAT_PER_IP=10
LLM_RATE_ANALYZE_PER_IP=6
LLM_RATE_SUGGESTIONS_PER_IP=20
LLM_RATE_REVIEW_PER_IP=30
LLM_GLOBAL_GUARD_CHAT=600
LLM_GLOBAL_GUARD_ANALYZE=600
LLM_GLOBAL_GUARD_REVIEW=600

# HTTP port for the Express server (optional, default 8080).
PORT=8080

# Bind host (optional, default 0.0.0.0; use 127.0.0.1 to stay local-only).
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Where these names are used elsewhere:
#
# - GitHub Actions: set `DEEPSEEK_API_KEY` as a repository/organization secret
#   (Settings → Secrets and variables → Actions). CI itself builds and tests
#   without secrets; the AI review workflow uses the secret above when present.
#   Enable secret scanning + push protection: Settings → Code security →
#   Secret scanning → Enable, and "Push protection" if available for the repo.
#
# - Cloud Run (or any container host): the Dockerfile sets HOST=0.0.0.0 and
#   PORT=8080; pass `DEEPSEEK_API_KEY` and `GEMINI_API_KEY` (and optionally
#   `STEAM_WEB_API_KEY`) as
#   the container's env vars, not baked into the image. If the platform injects
#   `PORT`, the server respects it.
# ---------------------------------------------------------------------------

# Optional first-party official .dem ingest; stays OFF in the default image.
# See docs/REPLAY_INGEST.md before production enablement.
REPLAY_INGEST_ENABLED=0
# DOTA_EXTRACT_BIN=/path/to/dota-extract
# COACH_EXTRACT_BIN=/path/to/dota-extract
# REPLAY_HOME=/tmp/dota2ai-replays
# Explicit opt-in for the Match page auto-submit hook; stays off in production.
REPLAY_AUTO_ENABLED=0
# Durable local jobs/artifacts/queue use REPLAY_HOME. For an explicitly
# provisioned private cloud bucket, all three use generation-checked GCS objects.
# REPLAY_GCS_BUCKET=private-bucket-name
# IAM-authenticated private worker used after enqueue. Leave unset locally.
# REPLAY_WORKER_URL=https://replay-worker.example.run.app
# Hard caps (optional). Unset values keep the documented defaults.
# REPLAY_BUDGET_DAILY_JOBS=100
# REPLAY_BUDGET_HOURLY_JOBS=60
# REPLAY_BUDGET_IP_TEN_MINUTES=3
# REPLAY_BUDGET_ATTEMPTS=150
# REPLAY_BUDGET_BYTES=25600000000
# REPLAY_BUDGET_WORKER_SECONDS=72000
# REPLAY_WORKER_DISPATCH_TIMEOUT_MS=900000

# Upstream source order: opendota (default) | steam_gc. See docs/MATCH_CACHE.md "When OpenDota is down".
# UPSTREAM_PRIMARY=opendota
# Self-hosted Steam GC retriever (services/steam-retriever/README.md: setup, limits, statuses).
# Both must be set to enable it. Keep the secret in Secret Manager, never in git.
# STEAM_RETRIEVER_URL=http://10.0.0.5:5700
# STEAM_RETRIEVER_SECRET=
# Our own odota/parser instance: "parse this match" without OpenDota (docs/SELF_HOSTED_PARSER.md).
# Needs the Steam GC retriever above. ODOTA_PARSER_AUDIENCE: the parser's Cloud Run URL,
# to call a private Cloud Run service with a Google ID token; leave unset on a private network.
# ODOTA_PARSER_URL=https://odota-parser-xxxxx.a.run.app
# ODOTA_PARSER_AUDIENCE=https://odota-parser-xxxxx.a.run.app
# Review agent (lib/agent): replay → trace → deep review → chat. docs/AGENT_PIPELINE.md.
# Storage: AGENT_BUCKET (GCS, objects under agent/), or directories on one machine.
# Parsing: TRACE_WORKER_URL (+ TRACE_WORKER_AUDIENCE for a private Cloud Run worker),
# or DOTA_EXTRACT_BIN to parse in process where the extractor is installed.
# With none of these every match answers "no parsed replay".
# Uses DEEPSEEK_API_KEY with thinking on; DEEP_REVIEW_THINKING=disabled turns it off.
# GLM_API_KEY is only for scripts/deep-review.mjs --provider glm (model comparison).
# AGENT_BUCKET=
# TRACE_WORKER_URL=https://trace-worker-xxxxx.a.run.app
# TRACE_WORKER_AUDIENCE=https://trace-worker-xxxxx.a.run.app
# AGENT_TRACE_DIR=/var/lib/dota2ai/traces
# AGENT_REVIEW_DIR=/var/lib/dota2ai/reviews
# DOTA_EXTRACT_BIN=/usr/local/bin/dota-extract
# AGENT_PARSE_DAILY_MAX=300
# Queue for started parses and reviews (Cloud Tasks; docs/AGENT_PIPELINE.md "Jobs that outlive a deploy").
# All three, or none: without them a job runs in the background of the instance that started it.
# AGENT_TASKS_QUEUE=projects/<project>/locations/<region>/queues/<queue>
# AGENT_RUN_URL=https://<site-service>-xxxxx.a.run.app
# AGENT_RUN_SA=<the site's service account email>
# DEEP_REVIEW_THINKING=enabled
# GLM_API_KEY=
