# ---------------------------------------------------------------------------
# dota2.ai environment example — copy to `.env` and fill in your own values.
# `.env` is gitignored. NEVER commit real keys. If a key ever lands in a commit,
# rotate it at the provider immediately.
# ---------------------------------------------------------------------------

# DeepSeek API key (REQUIRED for coach/review/chat features).
# Get your key: https://platform.deepseek.com/
# The server talks to DeepSeek's OpenAI-compatible endpoint (deepseek-chat).
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Steam Web API key (OPTIONAL).
# Improves localized hero names via the Steam GetHeroes endpoint.
# Without it the server gracefully falls back to OpenDota constants.
# Get your key: https://steamcommunity.com/dev/apikey
STEAM_WEB_API_KEY=

# OpenDota API key (OPTIONAL).
# Raises OpenDota rate limits for match data and the replay parse requests
# (POST /request/{match_id}) the review page submits for unparsed matches.
# Without it the server uses the free anonymous tier.
# Get your key: https://www.opendota.com/api-keys
OPENDOTA_API_KEY=

# Replay parse submission budgets (OPTIONAL, 10-minute sliding window).
# Global cap across all clients and per-client (IP) cap for submitting
# OpenDota parse requests. Over-budget requests are not submitted; the API
# returns parse status "throttled" with a retry hint instead.
PARSE_BUDGET_GLOBAL_MAX=10
PARSE_BUDGET_PER_CLIENT_MAX=3

# HTTP port for the Express server (optional, default 8080).
PORT=8080

# Bind host (optional, default 0.0.0.0; use 127.0.0.1 to stay local-only).
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Where these names are used elsewhere:
#
# - GitHub Actions: set `DEEPSEEK_API_KEY` as a repository/organization secret
#   (Settings → Secrets and variables → Actions). CI itself builds and tests
#   without secrets; the AI review workflow uses the secret above when present.
#   Enable secret scanning + push protection: Settings → Code security →
#   Secret scanning → Enable, and "Push protection" if available for the repo.
#
# - Cloud Run (or any container host): the Dockerfile sets HOST=0.0.0.0 and
#   PORT=8080; pass `DEEPSEEK_API_KEY` (and optionally `STEAM_WEB_API_KEY`) as
#   the container's env vars, not baked into the image. If the platform injects
#   `PORT`, the server respects it.
# ---------------------------------------------------------------------------
