# ---------------------------------------------------------------------------
# dota2.ai environment example — copy to `.env` and fill in your own values.
# `.env` is gitignored. NEVER commit real keys. If a key ever lands in a commit,
# rotate it at the provider immediately.
# ---------------------------------------------------------------------------

# DeepSeek API key (REQUIRED for coach/review/chat features).
# Get your key: https://platform.deepseek.com/
# The server talks to DeepSeek's OpenAI-compatible endpoint.
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# DeepSeek model name (OPTIONAL, default: deepseek-flash).
# Must match /^[a-z0-9][a-z0-9._-]{0,63}$/i or the default is used.
# Recommended names per the official docs (checked 2026-10-17):
# deepseek-flash (DeepSeek-V4.1-Flash-1017) and deepseek-v4-pro. The retired
# legacy names deepseek-chat / deepseek-reasoner (retired 2026-07-24 per the
# DeepSeek V4 notice) are mapped to deepseek-flash with a startup warning.
# Docs: https://api-docs.deepseek.com/
# DEEPSEEK_MODEL=deepseek-flash

# DeepSeek thinking mode (OPTIONAL, default: disabled).
# deepseek-flash enables thinking (effort high) by default, which adds a lot
# of latency; review cards and follow-ups must answer within a 40s deadline,
# so the server disables it unless explicitly enabled. Accepted: enabled | disabled.
# DEEPSEEK_THINKING=disabled

# Gemini API key (OPTIONAL, recommended in production).
# Fallback provider for match-review cards when DeepSeek fails or times out
# (40s per attempt). Cards can also run on Gemini alone; follow-up chat still
# needs DeepSeek. GEMINI_REVIEW_MODEL overrides the default model.
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_REVIEW_MODEL=gemini-3.5-flash-lite

# Steam Web API key (OPTIONAL).
# Improves localized hero names via the Steam GetHeroes endpoint.
# Without it the server gracefully falls back to OpenDota constants.
# Get your key: https://steamcommunity.com/dev/apikey
STEAM_WEB_API_KEY=

# OpenDota API key (OPTIONAL).
# Only used for the replay parse submission requests (POST /request/{match_id})
# the review page submits for unparsed matches. Other match-data requests
# always use the free anonymous tier.
# Get your key: https://www.opendota.com/api-keys
OPENDOTA_API_KEY=

# Trusted reverse-proxy hops (OPTIONAL).
# An EXACT topology count — the number of trusted proxies that append an entry
# to X-Forwarded-For before a request reaches this server. The client IP is
# taken as XFF[len-hops] for the per-client feedback rate limit and
# replay-parse budget. Do not tune it: measure the fronting topology instead.
#   1 (default) = Cloud Run direct or domain-mapped traffic: the Google Front
#                 End terminates TLS and appends exactly ONE entry — the real
#                 client (verified for dota2.ai: A records point at Google
#                 Front End 216.239.32/34/36/38.21, www is a
#                 ghs.googlehosted.com CNAME; no external HTTPS load balancer).
#   2           = an external HTTPS load balancer in front of Cloud Run (the
#                 LB appends "<client-ip>,<lb-ip>", client is 2nd from right)
#   +1 per extra fronting proxy (IAP / API Gateway / CDN)
# OVER-counting is dangerous: the pick drifts into the caller-controlled left
# side of the chain, letting clients spoof their IP and dodge per-client
# budgets. Under-counting is merely degrading (users share one bucket).
# Invalid or out-of-range values fall back to 1; the value is capped at 5.
# A chain shorter than the configured hops falls back to the (shared) proxy
# address — never an attacker-controlled left-side entry. X-Forwarded-For is
# only trusted when the TCP peer is private/loopback; direct public
# connections always use the socket address (spoof-safe).
TRUSTED_PROXY_HOPS=1

# Replay parse submission budgets (OPTIONAL, 10-minute sliding window).
# Global cap across all clients and per-client (IP) cap for submitting
# OpenDota parse requests. Over-budget requests are not submitted; the API
# returns parse status "throttled" with a retry hint instead.
PARSE_BUDGET_GLOBAL_MAX=10
PARSE_BUDGET_PER_CLIENT_MAX=3

# HTTP port for the Express server (optional, default 8080).
PORT=8080

# Bind host (optional, default 0.0.0.0; use 127.0.0.1 to stay local-only).
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Where these names are used elsewhere:
#
# - GitHub Actions: set `DEEPSEEK_API_KEY` as a repository/organization secret
#   (Settings → Secrets and variables → Actions). CI itself builds and tests
#   without secrets; the AI review workflow uses the secret above when present.
#   Enable secret scanning + push protection: Settings → Code security →
#   Secret scanning → Enable, and "Push protection" if available for the repo.
#
# - Cloud Run (or any container host): the Dockerfile sets HOST=0.0.0.0 and
#   PORT=8080; pass `DEEPSEEK_API_KEY` and `GEMINI_API_KEY` (and optionally
#   `STEAM_WEB_API_KEY`) as
#   the container's env vars, not baked into the image. If the platform injects
#   `PORT`, the server respects it.
# ---------------------------------------------------------------------------
