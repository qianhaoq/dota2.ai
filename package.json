{
  "name": "dota2-ai-assistant",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "preview:mock": "node scripts/mock-review-server.mjs",
    "start": "node server.js",
    "start:dev": "concurrently \"npm run dev\" \"npm start\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "express": "^4.22.3",
    "jsonrepair": "^3.15.0",
    "lucide-react": "^0.460.0",
    "openai": "^4.68.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.5",
    "glob": "^11.1.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.0",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "overrides": {
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.0",
    "shell-quote": "^1.11.0",
    "brace-expansion@>=4": "^5.0.12",
    "source-map-js": "^1.2.2",
    "postcss-selector-parser": "^7.1.6"
  },
  "workspaces": [
    "packages/*"
  ]
}
