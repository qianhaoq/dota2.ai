FROM node:22-bookworm-slim
ARG EXTRACTOR_PATH=vendor/dota-extract
RUN apt-get update && apt-get install -y --no-install-recommends util-linux && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --chown=node:node ${EXTRACTOR_PATH} /app/bin/dota-extract
COPY --chown=node:node lib/matchReview ./lib/matchReview
COPY --chown=node:node packages/review-engine ./packages/review-engine
COPY --chown=node:node scripts/replay-worker.mjs ./scripts/replay-worker.mjs
COPY --chown=node:node package.json ./package.json
ENV DOTA_EXTRACT_BIN=/app/bin/dota-extract REPLAY_HOME=/tmp/replay REPLAY_INGEST_ENABLED=1
USER node
CMD ["node", "scripts/replay-worker.mjs", "--serve"]
