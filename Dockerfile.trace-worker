# The review agent's replay worker (scripts/trace-worker.mjs). Build with the
# pinned extractor copied into the build context first (docs/AGENT_PIPELINE.md);
# never fetch a binary during the build.
FROM node:22-bookworm-slim
ARG EXTRACTOR_PATH=vendor/dota-extract
WORKDIR /app
COPY --chown=node:node ${EXTRACTOR_PATH} /app/bin/dota-extract
COPY --chown=node:node lib/agent/tracePipeline.js lib/agent/traceBuild.js lib/agent/stores.js ./lib/agent/
COPY --chown=node:node lib/matchReview/replayIngest ./lib/matchReview/replayIngest
COPY --chown=node:node packages/review-engine/src/trace ./packages/review-engine/src/trace
COPY --chown=node:node scripts/trace-worker.mjs ./scripts/trace-worker.mjs
COPY --chown=node:node package.json ./package.json
ENV DOTA_EXTRACT_BIN=/app/bin/dota-extract NODE_ENV=production
USER node
CMD ["node", "scripts/trace-worker.mjs"]
