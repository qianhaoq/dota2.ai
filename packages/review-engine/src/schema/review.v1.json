        "required": [
          "t",
          "killer",
          "team_gold_diff_at_t",
          "fact_id"
        ],
        "additionalProperties": false
      }
    },
    "purchases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "t": {
            "type": "number"
          },
          "item": {
            "type": "string"
          },
          "key_item": {
            "type": "boolean"
          }
        },
        "required": [
          "t",
          "item",
          "key_item"
        ],
        "additionalProperties": false
      }
    },
    "insights": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "enum": [
              "turning_point",
              "fix_this",
              "next_game"
            ]
          },
          "status": {
            "enum": [
              "ok",
              "insufficient"
            ]
          },
          "time": {
            "type": "object",
            "properties": {
              "from": {
                "type": "number"
              },
              "to": {
                "type": "number"
              }
            },
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false
          },
          "claim": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "slots": {
                "type": "string"
              },
              "phrasing": {
                "enum": [
                  "template",
                  "llm"
                ]
              }
            },
            "required": [
              "text",
              "slots",
              "phrasing"
            ],
            "additionalProperties": false
          },
          "fact_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label_key": {
                  "type": "string"
                },
                "fact_id": {
                  "type": "string"
                }
              },
              "required": [
                "label_key",
                "fact_id"
              ],
              "additionalProperties": false
            }
          },
          "evidence": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string"
              },
              "highlight": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "markers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "moments": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "kind",
              "highlight",
              "markers",
              "moments"
            ],
            "additionalProperties": false
          },
          "comeback": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "fact_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "fact_ids"
                ],
                "additionalProperties": false
              }
            ]
          },
          "baseline": {},
          "target": {},
          "citations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "data_gap": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string"
          },
          "pattern": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "status",
          "time",
          "claim",
          "fact_ids",
          "metrics",
          "evidence",
          "baseline",
          "target",
          "citations",
          "data_gap"
        ],
        "additionalProperties": false
      }
    },
    "data_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "topic",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "followups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "answerable": {
            "type": "boolean"
          },
          "fact_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "gap": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "answerable"
        ],
        "additionalProperties": false
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "provider": {
            "enum": [
              "opendota",
              "kb"
            ]
          },
          "url": {
            "type": "string"
          },
          "fetched_at": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ref": {
            "type": "string"
          },
          "patch": {},
          "source_date": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "provider"
        ],
        "additionalProperties": false
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "evidence_url": {
          "type": "string"
        },
        "generated_at": {
          "type": "string"
        },
        "cache": {
          "enum": [
            "hit",
            "miss"
          ]
        },
        "phrasing": {
          "enum": [
            "template",
            "llm"
          ]
        },
        "llm_provider": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "url",
        "evidence_url",
        "generated_at",
        "cache",
        "phrasing",
        "llm_provider"
      ],
      "additionalProperties": false
    }
