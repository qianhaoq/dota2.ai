{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReviewV1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "dota2.ai/review@1"
    },
    "engine_version": {
      "type": "string"
    },
    "state": {
      "enum": [
        "parsed",
        "unparsed",
        "insufficient"
      ]
    },
    "lang": {
      "enum": [
        "en",
        "zh"
      ]
    },
    "match": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "number",
            "null"
          ]
        },
        "duration_s": {
          "type": [
            "number",
            "null"
          ]
        },
        "winner": {
          "enum": [
            "radiant",
            "dire",
            null
          ]
        },
        "score": {
          "type": "object",
          "properties": {
            "radiant": {
              "type": [
                "number",
                "null"
              ]
            },
            "dire": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "radiant",
            "dire"
          ],
          "additionalProperties": false
        },
        "patch": {},
        "parsed": {
          "type": "boolean"
        },
        "parse_version": {
          "type": [
            "number",
            "null"
          ]
        },
        "start_time": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "duration_s",
        "winner",
        "score",
        "patch",
        "parsed",
        "parse_version",
        "start_time"
      ],
      "additionalProperties": false
    },
    "player": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "hero": {
              "type": [
                "string",
                "null"
              ]
            },
            "hero_id": {
              "type": "number"
            },
            "team": {
              "enum": [
                "radiant",
                "dire",
                null
              ]
            },
            "kda": {
              "type": "array",
              "items": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "minItems": 3,
              "maxItems": 3
            },
            "result": {
              "enum": [
                "win",
                "loss",
                null
              ]
            },
            "account_id": {
              "type": [
                "number",
                "null"
              ]
            },
            "personaname": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "hero",
            "hero_id",
            "team",
            "kda",
            "result",
            "account_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "roster": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "hero": {
            "type": [
              "string",
              "null"
            ]
          },
          "hero_id": {
            "type": "number"
          },
          "team": {
            "enum": [
              "radiant",
              "dire",
              null
            ]
          },
          "kda": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ]
            },
            "minItems": 3,
            "maxItems": 3
          },
          "personaname": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "hero",
          "hero_id",
          "team",
          "kda"
        ],
        "additionalProperties": false
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "scalar",
              "time",
              "count",
              "delta",
              "series_ref",
              "entity"
            ]
          },
          "value": {},
          "unit": {
            "type": "string"
          },
          "t": {
            "type": "number"
          },
          "perspective": {
            "enum": [
              "player_team",
              "radiant"
            ]
          },
          "display": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string"
              },
              "zh": {
                "type": "string"
              },
              "t": {
                "type": "string"
              }
            },
            "required": [
              "en",
              "zh"
            ],
            "additionalProperties": false
          },
          "derivation": {
            "type": "string"
          },
          "citation": {
            "type": "string"
          },
          "source_path": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "value",
          "display"
        ],
        "additionalProperties": false
      }
    },
    "series": {
      "type": "object",
      "properties": {
        "radiant_gold_adv": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "radiant_xp_adv": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "perspective": {
          "enum": [
            "radiant",
            "dire",
            null
          ]
        }
      },
      "required": [
        "radiant_gold_adv",
        "radiant_xp_adv",
        "perspective"
      ],
      "additionalProperties": false
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "t": {
            "type": "number"
          },
          "type": {
            "type": "string"
          },
          "key": {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          "team": {
            "enum": [
              "radiant",
              "dire",
              null
            ]
          },
          "fact_id": {
            "type": "string"
          }
        },
        "required": [
          "t",
          "type",
          "key",
          "team",
          "fact_id"
        ],
        "additionalProperties": false
      }
    },
    "deaths": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "t": {
            "type": "number"
          },
          "killer": {
            "type": [
              "string",
              "null"
            ]
          },
          "team_gold_diff_at_t": {
            "type": [
              "number",
              "null"
            ]
          },
          "fact_id": {
            "type": "string"
          }
