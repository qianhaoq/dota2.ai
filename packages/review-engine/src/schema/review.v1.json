  "required": [
    "schema",
    "engine_version",
    "state",
    "lang",
    "match",
    "player",
    "roster",
    "facts",
    "series",
    "objectives",
    "deaths",
    "purchases",
    "insights",
    "data_gaps",
    "followups",
    "citations",
    "meta"
  ],
  "additionalProperties": false
}