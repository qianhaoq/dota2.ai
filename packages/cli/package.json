  },
  "dependencies": {
    "@dota2ai/review-engine": "*"
  },
  "bundleDependencies": [
    "@dota2ai/review-engine"
  ],
  "scripts": {
    "prepack": "node scripts/prepare-pack.js",
    "postpack": "node -e \"const fs=require('node:fs');fs.rmSync('node_modules/@dota2ai/review-engine',{recursive:true,force:true});fs.rmSync('src/vendor',{recursive:true,force:true})\""
